<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CBT Seni Rupa Kelas 5 - Menggambar Ritme</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans & Fredoka -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Fredoka', 'cursive'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f3ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }
        .font-display {
            font-family: 'Fredoka', cursive;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-200">
                    <i class="fa-solid fa-palette text-xl"></i>
                </div>
                <div>
                    <h1 class="font-display font-bold text-lg sm:text-xl text-slate-800 leading-tight">CBT Seni Rupa SD</h1>
                    <p class="text-xs text-slate-500 font-medium">Kelas 5 • Materi: Menggambar Ritme</p>
                </div>
            </div>

            <!-- Role Switcher & Share Button -->
            <div class="flex items-center space-x-2">
                <button onclick="openShareModal()" class="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 text-xs sm:text-sm font-bold transition-all duration-200 flex items-center space-x-1.5 shadow-sm">
                    <i class="fa-solid fa-share-nodes text-emerald-600"></i>
                    <span class="hidden sm:inline">Bagikan Ujian</span>
                </button>
                <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200">
                    <button id="btn-mode-siswa" onclick="switchView('siswa')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold transition-all duration-200 bg-indigo-600 text-white shadow-sm">
                        <i class="fa-solid fa-user-graduate mr-1.5"></i> Mode Siswa
                    </button>
                    <button id="btn-mode-guru" onclick="switchView('guru')" class="px-3 sm:px-4 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-slate-600 hover:text-slate-900 transition-all duration-200">
                        <i class="fa-solid fa-chalkboard-user mr-1.5"></i> Portal Guru
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-grow w-full">

        <!-- ================= SISWA SECTION ================= -->
        <section id="siswa-section" class="space-y-6">
            
            <!-- Step 1: Form Identitas Siswa -->
            <div id="student-login-card" class="max-w-md mx-auto bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8">
                <div class="text-center mb-6">
                    <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-3 text-2xl font-bold">
                        <i class="fa-solid fa-file-pen"></i>
                    </div>
                    <h2 class="text-xl font-bold text-slate-800">Ulangan Harian CBT</h2>
                    <p class="text-sm text-slate-500 mt-1">Seni Rupa Bab 2: Menggambar Ritme dalam Karya Seni</p>
                </div>

                <form onsubmit="startExam(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Nama Lengkap Siswa</label>
                        <input type="text" id="student-name" required placeholder="Contoh: Anisa Rahmawati" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm">
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Nomor Absen</label>
                            <input type="number" id="student-no" required min="1" max="50" placeholder="1-40" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">Kelas</label>
                            <select id="student-class" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm bg-white">
                                <option value="5A">Kelas 5A</option>
                                <option value="5B">Kelas 5B</option>
                                <option value="5C">Kelas 5C</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1">PIN Ujian Guru (Opsional)</label>
                        <input type="text" id="student-pin" placeholder="Masukkan PIN (misal: RITME5)" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition text-sm font-mono uppercase">
                    </div>

                    <div class="bg-amber-50 border border-amber-200 rounded-xl p-3 text-xs text-amber-800 flex items-start space-x-2">
                        <i class="fa-solid fa-triangle-exclamation text-amber-600 text-sm mt-0.5"></i>
                        <span>Jumlah Soal: <strong>10 Pilihan Ganda</strong> • Waktu: <strong>15 Menit</strong> • KKM: <strong>75</strong>. Kerjakan dengan jujur!</span>
                    </div>

                    <button type="submit" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg shadow-indigo-200 transition-all duration-200 flex items-center justify-center space-x-2 text-sm">
                        <span>Mulai Kerjakan Ujian</span>
                        <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </form>
            </div>

            <!-- Step 2: CBT Interface (Hidden initially) -->
            <div id="cbt-interface" class="hidden grid grid-cols-1 lg:grid-cols-4 gap-6">
                <!-- Left/Top: Questions & Options (3 Cols) -->
                <div class="lg:col-span-3 space-y-4">
                    <!-- Top Info Bar -->
                    <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <span class="bg-indigo-100 text-indigo-700 font-bold px-3 py-1 rounded-lg text-sm" id="cbt-student-tag">
                                Siswa: -
                            </span>
                            <span class="text-xs text-slate-500 hidden sm:inline" id="cbt-class-tag">Kelas 5A</span>
                        </div>
                        <div class="flex items-center space-x-2 bg-rose-50 border border-rose-200 px-3 py-1.5 rounded-xl text-rose-700 font-mono font-bold text-sm">
                            <i class="fa-solid fa-clock text-rose-500 animate-pulse"></i>
                            <span id="timer-display">15:00</span>
                        </div>
                    </div>

                    <!-- Question Container -->
                    <div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-sm space-y-6">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                            <span class="font-bold text-indigo-600 text-sm uppercase tracking-wide" id="question-number-title">Soal No. 1</span>
                            <span class="text-xs text-slate-400">Bobot: 10 Poin</span>
                        </div>

                        <!-- Question Text -->
                        <div class="text-slate-800 font-semibold text-base sm:text-lg leading-relaxed" id="question-text">
                            Loading pertanyaan...
                        </div>

                        <!-- Options List -->
                        <div class="space-y-3" id="options-container">
                            <!-- Options injected dynamically -->
                        </div>

                        <!-- Bottom Controls -->
                        <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                            <button onclick="navigateQuestion(-1)" id="btn-prev" class="px-4 py-2 rounded-xl border border-slate-300 text-slate-600 hover:bg-slate-50 font-bold text-sm transition flex items-center space-x-2">
                                <i class="fa-solid fa-chevron-left"></i>
                                <span>Sebelumnya</span>
                            </button>

                            <label class="inline-flex items-center space-x-2 cursor-pointer bg-slate-100 px-3 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-700 hover:bg-slate-200 transition">
                                <input type="checkbox" id="check-ragu" onchange="toggleRagu()" class="w-4 h-4 text-amber-500 rounded focus:ring-amber-400">
                                <span class="text-amber-700"><i class="fa-solid fa-flag text-amber-500 mr-1"></i> Ragu-ragu</span>
                            </label>

                            <button onclick="navigateQuestion(1)" id="btn-next" class="px-4 py-2 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 font-bold text-sm transition flex items-center space-x-2">
                                <span>Berikutnya</span>
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Right/Side: Navigation Grid (1 Col) -->
                <div class="lg:col-span-1 space-y-4">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                        <h3 class="font-bold text-slate-800 text-sm border-b border-slate-100 pb-2">Navigasi Soal</h3>
                        
                        <div class="grid grid-cols-5 gap-2" id="question-nav-grid">
                            <!-- Grid items generated by JS -->
                        </div>

                        <!-- Legend -->
                        <div class="pt-3 border-t border-slate-100 space-y-1.5 text-xs text-slate-500 font-medium">
                            <div class="flex items-center space-x-2">
                                <span class="w-3 h-3 rounded bg-indigo-600"></span>
                                <span>Sudah Dijawab</span>
                            </div>
                            <div class="flex items-center space-x-2">
                                <span class="w-3 h-3 rounded bg-amber-400"></span>
                                <span>Ragu-ragu</span>
                            </div>
                            <div class="flex items-center space-x-2">
                                <span class="w-3 h-3 rounded bg-slate-200"></span>
                                <span>Belum Dijawab</span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button onclick="confirmSubmitExam()" class="w-full mt-2 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-xl shadow-md transition flex items-center justify-center space-x-2 text-sm">
                            <i class="fa-solid fa-paper-plane"></i>
                            <span>Selesai & Kirim</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Step 3: Exam Result Modal / View (Hidden initially) -->
            <div id="cbt-result-view" class="hidden max-w-3xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8 space-y-6">
                <div class="text-center space-y-2 border-b border-slate-100 pb-6">
                    <div id="score-badge-icon" class="w-20 h-20 rounded-full flex items-center justify-center mx-auto text-3xl mb-2">
                        <!-- Dynamic icon -->
                    </div>
                    <h2 class="text-2xl font-bold text-slate-800" id="result-title">Hasil Ulangan CBT</h2>
                    <p class="text-sm text-slate-500" id="result-student-info">Anisa Rahmawati (Absen 12) - Kelas 5A</p>

                    <div class="flex items-center justify-center space-x-6 py-4">
                        <div class="bg-slate-50 border border-slate-200 px-6 py-3 rounded-2xl">
                            <span class="text-xs uppercase font-bold text-slate-400 block">Nilai Akhir</span>
                            <span class="text-4xl font-extrabold text-indigo-600 font-display" id="final-score-val">0</span>
                        </div>
                        <div class="bg-slate-50 border border-slate-200 px-6 py-3 rounded-2xl">
                            <span class="text-xs uppercase font-bold text-slate-400 block">Status KKM (75)</span>
                            <span class="text-lg font-bold" id="kkm-status-badge">TUNTAS</span>
                        </div>
                    </div>
                </div>

                <!-- Detail Answers Review -->
                <div class="space-y-4">
                    <h3 class="font-bold text-slate-800 text-base flex items-center justify-between">
                        <span>Pembahasan Soal & Jawaban</span>
                        <span class="text-xs font-normal text-slate-500">Hijau = Benar • Merah = Salah</span>
                    </h3>

                    <div class="space-y-3 max-h-96 overflow-y-auto pr-2 custom-scrollbar" id="review-list">
                        <!-- Injected via JS -->
                    </div>
                </div>

                <div class="flex justify-center pt-4">
                    <button onclick="resetStudentExam()" class="px-6 py-2.5 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition shadow">
                        <i class="fa-solid fa-rotate-right mr-2"></i> Mengerjakan Ulang (Simulasi)
                    </button>
                </div>
            </div>

        </section>

        <!-- ================= GURU PORTAL SECTION ================= -->
        <section id="guru-section" class="hidden space-y-6">
            
            <!-- Dashboard Header Stats -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase">Total Peserta</p>
                        <h3 class="text-2xl font-extrabold text-slate-800" id="stat-total-siswa">0</h3>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase">Rata-rata Nilai</p>
                        <h3 class="text-2xl font-extrabold text-slate-800" id="stat-avg-score">0</h3>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase">Ketuntasan (≥75)</p>
                        <h3 class="text-2xl font-extrabold text-slate-800" id="stat-pass-rate">0%</h3>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl font-bold">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase">Tertinggi / Terendah</p>
                        <h3 class="text-xl font-extrabold text-slate-800"><span id="stat-high-score">0</span> / <span id="stat-low-score" class="text-slate-500">0</span></h3>
                    </div>
                </div>
            </div>

            <!-- Material Analytics & Topic Breakdown -->
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                <h3 class="font-bold text-slate-800 text-base flex items-center space-x-2">
                    <i class="fa-solid fa-book-open text-indigo-600"></i>
                    <span>Analisis Penguasaan Indikator Materi (Seni Rupa - Ritme)</span>
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="topic-analytics-container">
                    <!-- Analytics Bars -->
                </div>
            </div>

            <!-- Table Section -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden space-y-4 p-6">
                <!-- Filters & Search -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                    <div class="flex items-center space-x-2 w-full sm:w-auto">
                        <input type="text" id="teacher-search" oninput="renderTeacherTable()" placeholder="Cari nama siswa..." class="px-4 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none w-full sm:w-64">
                        <select id="teacher-class-filter" onchange="renderTeacherTable()" class="px-3 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                            <option value="ALL">Semua Kelas</option>
                            <option value="5A">Kelas 5A</option>
                            <option value="5B">Kelas 5B</option>
                            <option value="5C">Kelas 5C</option>
                        </select>
                    </div>

                    <div class="flex items-center space-x-2 w-full sm:w-auto justify-end">
                        <button onclick="exportCSV()" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition flex items-center space-x-1.5">
                            <i class="fa-solid fa-file-excel text-emerald-600"></i>
                            <span>Ekspor Nilai (CSV)</span>
                        </button>
                        <button onclick="addMockData()" class="px-3 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-xs rounded-xl transition flex items-center space-x-1.5">
                            <i class="fa-solid fa-plus"></i>
                            <span>Tambah Data Simulasi</span>
                        </button>
                    </div>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-slate-600">
                        <thead class="bg-slate-50 text-slate-700 font-bold uppercase text-xs border-y border-slate-200">
                            <tr>
                                <th class="py-3.5 px-4">No</th>
                                <th class="py-3.5 px-4">Nama Siswa</th>
                                <th class="py-3.5 px-4">Kelas</th>
                                <th class="py-3.5 px-4">Absen</th>
                                <th class="py-3.5 px-4">Waktu Selesai</th>
                                <th class="py-3.5 px-4">Nilai</th>
                                <th class="py-3.5 px-4">Status</th>
                                <th class="py-3.5 px-4 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="teacher-table-body" class="divide-y divide-slate-100">
                            <!-- Injected JS -->
                        </tbody>
                    </table>
                </div>
            </div>

        </section>

    </main>

    <!-- Modal Detail Jawaban Siswa untuk Guru -->
    <div id="detail-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-6 space-y-4 max-h-[90vh] flex flex-col shadow-xl">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                    <h3 class="font-bold text-lg text-slate-800" id="modal-student-name">Detail Jawaban Siswa</h3>
                    <p class="text-xs text-slate-500" id="modal-student-info">-</p>
                </div>
                <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="overflow-y-auto space-y-3 custom-scrollbar flex-grow pr-1" id="modal-answers-list">
                <!-- Content injected dynamically -->
            </div>

            <div class="pt-3 border-t border-slate-100 text-right">
                <button onclick="closeModal()" class="px-5 py-2 bg-slate-200 text-slate-700 font-bold rounded-xl text-sm hover:bg-slate-300 transition">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <!-- Modal Bagikan Link Ujian ke Siswa (Peningkatan Aksesibilitas Share) -->
    <div id="share-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 space-y-5 shadow-2xl border border-slate-100">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center space-x-2">
                    <div class="w-9 h-9 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center font-bold text-lg">
                        <i class="fa-solid fa-share-nodes"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-base text-slate-800">Bagikan Ujian CBT</h3>
                        <p class="text-xs text-slate-500">Kirim tautan langsung ke siswa atau grup WA</p>
                    </div>
                </div>
                <button onclick="closeShareModal()" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="space-y-4">
                <!-- URL Input with Edit Ability -->
                <div>
                    <label class="block text-xs font-bold uppercase text-slate-500 mb-1">Tautan / Link Ujian CBT</label>
                    <div class="flex items-center space-x-2">
                        <input type="text" id="share-link-input" oninput="updateQRAndShareLinks()" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-mono text-slate-800 focus:ring-2 focus:ring-indigo-500 outline-none">
                        <button onclick="copyShareLink()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition flex-shrink-0 flex items-center space-x-1.5 shadow-sm">
                            <i class="fa-solid fa-copy"></i>
                            <span>Salin</span>
                        </button>
                    </div>
                    <span class="text-[11px] text-slate-400 mt-1 block">*Link dapat disesuaikan jika menggunakan domain server sekolah tersendiri.</span>
                </div>

                <!-- Direct Action Buttons: WhatsApp & Native Share -->
                <div class="grid grid-cols-2 gap-3">
                    <a id="btn-share-wa" href="#" target="_blank" class="flex items-center justify-center space-x-2 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs shadow-sm transition">
